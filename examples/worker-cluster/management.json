{
  "node": "active",
  "urls": "https://0.0.0.0:5443",
  "policy": "/etc/universaldata/management-policy.json",
  "worker-supervisor-config": "/etc/universaldata/worker-supervisor.json",
  "Cluster": {
    "ConnectionFile": "/run/secrets/universaldata-postgresql",
    "EncryptionKeyFile": "/run/secrets/universaldata-catalog-key"
  },
  "WorkerNodes": {
    "worker-1": {
      "CertificateSha256": "REPLACE_WITH_WORKER_1_CERTIFICATE_SHA256",
      "Tenants": ["data-platform"]
    },
    "worker-2": {
      "CertificateSha256": "REPLACE_WITH_WORKER_2_CERTIFICATE_SHA256",
      "Tenants": ["data-platform"]
    },
    "worker-3": {
      "CertificateSha256": "REPLACE_WITH_WORKER_3_CERTIFICATE_SHA256",
      "Tenants": ["data-platform"]
    }
  }
}
