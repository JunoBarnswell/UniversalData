              },
              "batchSize": 512
            }
          },
          {
            "id": "map",
            "component": "derive",
            "config": {
              "columns": {
                "$template": "mapping"
              }
            }
          },
          {
            "id": "write",
            "component": "file.ndjson.destination",
            "config": {
              "connection": {
                "$template": "destination"
              }
            }
          }
        ],
        "paths": [
          {
            "from": "read",
            "to": "map",
            "input": 0,
            "output": 0
          },
          {
            "from": "map",
            "to": "write",
            "input": 0,
            "output": 0
          }
        ]
      },
