<Project Sdk="Microsoft.NET.Sdk.Web">
  <Import Project="../../metadata/ProductVersion.props" />
  <PropertyGroup><TargetFramework>net10.0</TargetFramework><Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings><Version>$(UDSdkVersion)</Version></PropertyGroup>
  <ItemGroup><ProjectReference Include="../UniversalData.Hosting/UniversalData.Hosting.csproj" /></ItemGroup>
  <ItemGroup Condition="'$(DesignerAssets)' != ''">
    <Content Remove="wwwroot/**/*" />
    <Content Include="$(DesignerAssets)/**/*" Link="wwwroot/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
