<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="../../../metadata/ProductVersion.props" />
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PackageId>UniversalData</PackageId>
    <Version>$(UDSdkVersion)</Version>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <Description>Native Package/Execution and columnar data SDK with thin .NET bindings.</Description>
    <RepositoryUrl>https://github.com/JunoBarnswell/UniversalData</RepositoryUrl>
  </PropertyGroup>
  <PropertyGroup Condition="'$(NativeRuntimeIdentifier)' != ''">
    <NativeLibraryName Condition="'$(NativeRuntimeIdentifier)' == 'win-x64'">ud_data.dll</NativeLibraryName>
    <NativeLibraryName Condition="'$(NativeRuntimeIdentifier)' == 'linux-x64'">libud_data.so</NativeLibraryName>
  </PropertyGroup>
  <ItemGroup Condition="'$(NativeLibraryDirectory)' != ''">
    <None Include="$(NativeLibraryDirectory)/$(NativeLibraryName)" Pack="true" PackagePath="runtimes/$(NativeRuntimeIdentifier)/native/" />
    <None Include="$(NativeDependencyDirectory)/*" Condition="'$(NativeDependencyDirectory)' != ''" Pack="true" PackagePath="runtimes/$(NativeRuntimeIdentifier)/native/" />
    <None Include="$(NativeLicenseDirectory)/**/*" Condition="'$(NativeLicenseDirectory)' != ''" Pack="true" PackagePath="licenses/" />
  </ItemGroup>
  <Target Name="ValidateNativePackage" BeforeTargets="GenerateNuspec">
    <Error Condition="('$(NativeLibraryDirectory)' != '' Or '$(NativeRuntimeIdentifier)' != '') And ('$(NativeLibraryDirectory)' == '' Or '$(NativeLibraryName)' == '')" Text="Specify NativeLibraryDirectory and a supported NativeRuntimeIdentifier together." />
    <Error Condition="'$(NativeLibraryDirectory)' != '' And !Exists('$(NativeLibraryDirectory)/$(NativeLibraryName)')" Text="Missing native runtime library for $(NativeRuntimeIdentifier)." />
  </Target>
</Project>
