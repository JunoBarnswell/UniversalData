<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="../../../metadata/ProductVersion.props" />
  <PropertyGroup>
    <TargetFramework>$(UDDotnetTargetFramework)</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PackageId>UniversalData</PackageId>
    <Version>$(UDSdkVersion)</Version>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <Description>Typed SQL and ETL SDK with execution isolated in the UniversalData Worker.</Description>
    <RepositoryUrl>https://github.com/JunoBarnswell/UniversalData</RepositoryUrl>
  </PropertyGroup>
  <PropertyGroup Condition="'$(IncludeUniversalDataRuntimeDependencies)' == 'true'">
    <NuspecFile>$(MSBuildProjectDirectory)/UniversalData.nuspec</NuspecFile>
    <NuspecBasePath>$(MSBuildProjectDirectory)</NuspecBasePath>
    <NuspecProperties>version=$(UDSdkVersion);SqlSugarCore=$(UDSqlSugarCoreVersion);MySqlConnector=$(UDMySqlConnectorVersion);SQLitePCLRawlibe_sqlite3=$(UDSQLitePCLRawlibe_sqlite3Version);SystemSecurityCryptographyPkcs=$(UDSystemSecurityCryptographyPkcsVersion);YamlDotNet=$(UDYamlDotNetVersion);MicrosoftExtensionsDependencyInjectionAbstractions=$(UDMicrosoftExtensionsDependencyInjectionAbstractionsVersion);MicrosoftExtensionsConfigurationAbstractions=$(UDMicrosoftExtensionsConfigurationAbstractionsVersion)</NuspecProperties>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="SqlSugarCore" Version="[$(UDSqlSugarCoreVersion)]" />
    <PackageReference Include="MySqlConnector" Version="[$(UDMySqlConnectorVersion)]" />
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="[$(UDSQLitePCLRawlibe_sqlite3Version)]" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="[$(UDSystemSecurityCryptographyPkcsVersion)]" />
    <PackageReference Include="YamlDotNet" Version="[$(UDYamlDotNetVersion)]" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="[$(UDMicrosoftExtensionsDependencyInjectionAbstractionsVersion)]" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="[$(UDMicrosoftExtensionsConfigurationAbstractionsVersion)]" />
  </ItemGroup>
</Project>
