<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PackageId>UniversalData</PackageId>
    <Version>1.0.0</Version>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <Description>Native Package/Execution and columnar data SDK with thin .NET bindings.</Description>
    <RepositoryUrl>https://github.com/JunoBarnswell/UniversalData</RepositoryUrl>
  </PropertyGroup>
  <ItemGroup Condition="'$(NativeArtifacts)' != ''">
    <None Include="$(NativeArtifacts)/win-x64/ud_data.dll" Condition="Exists('$(NativeArtifacts)/win-x64/ud_data.dll')" Pack="true" PackagePath="runtimes/win-x64/native/" />
    <None Include="$(NativeArtifacts)/linux-x64/libud_data.so" Condition="Exists('$(NativeArtifacts)/linux-x64/libud_data.so')" Pack="true" PackagePath="runtimes/linux-x64/native/" />
  </ItemGroup>
</Project>
