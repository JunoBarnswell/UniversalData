<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="../../../metadata/ProductVersion.props" />
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PackageId>UniversalData</PackageId>
    <Version>$(UDSdkVersion)</Version>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <Description>Typed SQL and ETL SDK with execution isolated in the UniversalData Worker.</Description>
    <RepositoryUrl>https://github.com/JunoBarnswell/UniversalData</RepositoryUrl>
  </PropertyGroup>
  <PropertyGroup Condition="'$(IncludeUniversalDataRuntimeDependencies)' == 'true'">
    <NuspecFile>$(MSBuildProjectDirectory)/UniversalData.nuspec</NuspecFile>
    <NuspecBasePath>$(MSBuildProjectDirectory)</NuspecBasePath>
    <NuspecProperties>version=$(UDSdkVersion)</NuspecProperties>
  </PropertyGroup>
</Project>
