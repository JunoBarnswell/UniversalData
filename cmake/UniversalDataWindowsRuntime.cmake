include_guard(GLOBAL)

set(UD_WINDOWS_RUNTIME_DIRS "" CACHE STRING "Additional directories containing the configured Windows SDKs' runtime DLLs")
get_filename_component(linker_directory "${CMAKE_LINKER}" DIRECTORY)
if(MSVC)
  find_program(UD_WINDOWS_DUMPBIN dumpbin HINTS "${linker_directory}" REQUIRED)
  set(UD_WINDOWS_DEPENDENCY_TOOL dumpbin)
  set(UD_WINDOWS_DEPENDENCY_COMMAND "${UD_WINDOWS_DUMPBIN}")
else()
  set(UD_WINDOWS_DEPENDENCY_TOOL objdump)
  set(UD_WINDOWS_DEPENDENCY_COMMAND "${CMAKE_OBJDUMP}")
endif()

function(ud_windows_runtime name)
  cmake_parse_arguments(PARSE_ARGV 1 runtime "" "BUILD_DIRECTORY"
    "LIBRARIES;MODULES;LINK_INPUTS;DATA_DLLS;EXTERNAL_DLLS")
  set(runtime_dirs ${UD_WINDOWS_RUNTIME_DIRS})
  foreach(link_input IN LISTS runtime_LINK_INPUTS)
    if(TARGET "${link_input}")
      get_target_property(kind "${link_input}" TYPE)
      if(kind MATCHES "^(SHARED|UNKNOWN)_LIBRARY$")
        list(APPEND runtime_dirs "$<TARGET_FILE_DIR:${link_input}>" "$<TARGET_FILE_DIR:${link_input}>/../bin")
      endif()
    elseif(IS_ABSOLUTE "${link_input}")
      get_filename_component(directory "${link_input}" DIRECTORY)
      list(APPEND runtime_dirs "${directory}" "${directory}/../bin")
    endif()
  endforeach()
  cmake_path(CONVERT "$ENV{CMAKE_PREFIX_PATH}" TO_CMAKE_PATH_LIST environment_prefixes)
  set(prefixes ${CMAKE_PREFIX_PATH} ${environment_prefixes})
  if(VCPKG_TARGET_TRIPLET)
    foreach(installed IN ITEMS "${VCPKG_INSTALLED_DIR}" "${_VCPKG_INSTALLED_DIR}")
      if(installed)
        set(prefix "${installed}/${VCPKG_TARGET_TRIPLET}")
        list(APPEND runtime_dirs "$<$<CONFIG:Debug>:${prefix}/debug/bin>")
        list(APPEND prefixes "${prefix}")
      endif()
    endforeach()
  endif()
  foreach(prefix IN LISTS prefixes)
    list(APPEND runtime_dirs "${prefix}/bin")
  endforeach()
  list(REMOVE_DUPLICATES runtime_dirs)

  foreach(kind LIBRARIES MODULES)
    foreach(target IN LISTS runtime_${kind})
      list(APPEND ${kind} "$<TARGET_FILE:${target}>")
    endforeach()
  endforeach()
  set(staged_directory "${PROJECT_BINARY_DIR}/windows-runtime/$<CONFIG>/${name}")
  configure_file("${CMAKE_CURRENT_FUNCTION_LIST_DIR}/StageWindowsRuntime.cmake.in"
    "${CMAKE_CURRENT_BINARY_DIR}/${name}.cmake.in" @ONLY)
  set(command_file "${staged_directory}.cmake")
  file(GENERATE OUTPUT "${command_file}" INPUT "${CMAKE_CURRENT_BINARY_DIR}/${name}.cmake.in")
  add_custom_target(${name} ALL COMMAND "${CMAKE_COMMAND}" -P "${command_file}"
    DEPENDS ${runtime_LIBRARIES} ${runtime_MODULES} VERBATIM)
  set(${name}_DIRECTORY "${staged_directory}" PARENT_SCOPE)
endfunction()
