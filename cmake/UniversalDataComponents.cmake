# One component graph for build selection and installed static consumers.
# The installed Data facade already contains this implementation and exposes
# no third-party headers or static link dependencies to its consumers.
function(ud_component_closure output expand_data)
  set(selected ${ARGN})
  foreach(pass RANGE 0 8)
    foreach(component IN LISTS selected)
      if(component STREQUAL "Data")
        if(expand_data)
          list(APPEND selected Foundation Columnar Expression Compute Runtime Contracts Plugins Package)
        endif()
      elseif(component STREQUAL "Package")
        list(APPEND selected Expression Compute Runtime Plugins)
      elseif(component STREQUAL "Expression")
        list(APPEND selected Columnar Plugins)
      elseif(component STREQUAL "Compute")
        list(APPEND selected Columnar Expression Runtime)
      elseif(component STREQUAL "Runtime")
        list(APPEND selected Columnar)
      elseif(component STREQUAL "Plugins")
        list(APPEND selected Columnar Contracts)
      elseif(component STREQUAL "Columnar")
        list(APPEND selected Foundation)
      elseif(NOT component MATCHES "^(Foundation|Contracts)$")
        message(FATAL_ERROR "Unknown UniversalData component: ${component}")
      endif()
    endforeach()
    list(REMOVE_DUPLICATES selected)
  endforeach()
  set(${output} ${selected} PARENT_SCOPE)
endfunction()
