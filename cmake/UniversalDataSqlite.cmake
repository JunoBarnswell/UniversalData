include_guard(GLOBAL)
set(UD_SQLITE_AMALGAMATION "" CACHE PATH "External SQLite amalgamation for the native Catalog and connector")
set(UD_SQLITE_EMBEDDED OFF)
if(UD_SQLITE_AMALGAMATION)
  if(NOT EXISTS "${UD_SQLITE_AMALGAMATION}/sqlite3.c" OR NOT EXISTS "${UD_SQLITE_AMALGAMATION}/sqlite3.h")
    message(FATAL_ERROR "UD_SQLITE_AMALGAMATION must contain genuine SQLite source and headers")
  endif()
  set(UD_SQLITE_EMBEDDED ON)
  add_library(ud_sqlite_dependency STATIC "${UD_SQLITE_AMALGAMATION}/sqlite3.c")
  set_target_properties(ud_sqlite_dependency PROPERTIES EXPORT_NAME SQLiteRuntime)
  target_include_directories(ud_sqlite_dependency PUBLIC
    $<BUILD_INTERFACE:${UD_SQLITE_AMALGAMATION}>
    $<INSTALL_INTERFACE:${CMAKE_INSTALL_INCLUDEDIR}/UniversalData/dependencies/sqlite>)
  if(NOT WIN32)
    find_package(Threads REQUIRED)
    target_link_libraries(ud_sqlite_dependency PUBLIC Threads::Threads ${CMAKE_DL_LIBS} m)
  endif()
  add_library(SQLite::SQLite3 ALIAS ud_sqlite_dependency)
  install(TARGETS ud_sqlite_dependency EXPORT UniversalDataTargets ARCHIVE DESTINATION ${CMAKE_INSTALL_LIBDIR})
  install(FILES "${UD_SQLITE_AMALGAMATION}/sqlite3.h" DESTINATION ${CMAKE_INSTALL_INCLUDEDIR}/UniversalData/dependencies/sqlite)
else()
  find_package(SQLite3 3.35 REQUIRED)
endif()
