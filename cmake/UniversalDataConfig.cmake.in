@PACKAGE_INIT@
include("${CMAKE_CURRENT_LIST_DIR}/UniversalDataTargets.cmake")
foreach(component Foundation Columnar Compute Runtime Contracts Plugins ETL Query Data)
  if(TARGET UniversalData::${component})
    set(UniversalData_${component}_FOUND TRUE)
  endif()
endforeach()
check_required_components(UniversalData)
