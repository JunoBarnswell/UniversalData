@PACKAGE_INIT@
include(CMakeFindDependencyMacro)
list(APPEND CMAKE_MODULE_PATH "${CMAKE_CURRENT_LIST_DIR}")
set(UniversalData_installed_components "@UD_SELECTED@")
include("${CMAKE_CURRENT_LIST_DIR}/UniversalDataComponents.cmake")
if(UniversalData_FIND_COMPONENTS)
  ud_component_closure(UniversalData_link_components FALSE ${UniversalData_FIND_COMPONENTS})
else()
  set(UniversalData_link_components ${UniversalData_installed_components})
endif()
if("Runtime" IN_LIST UniversalData_link_components OR "Plugins" IN_LIST UniversalData_link_components)
  find_dependency(Threads)
  if(@UD_WITH_HTTP@)
    find_dependency(CURL 7.85)
  endif()
endif()
if("Package" IN_LIST UniversalData_link_components)
  find_dependency(ZLIB)
  find_dependency(EXPAT)
  if(@UD_WITH_XML@)
    find_dependency(LibXml2 2.9.12)
    find_dependency(LibXslt 1.1)
  endif()
  if(NOT @UD_SQLITE_EMBEDDED@)
    find_dependency(SQLite3 3.35)
  endif()
endif()
if("Columnar" IN_LIST UniversalData_link_components)
  find_dependency(ICU 76 COMPONENTS uc i18n)
endif()
if("Compute" IN_LIST UniversalData_link_components)
  find_dependency(UDPCRE2 10.42)
endif()
if("Package" IN_LIST UniversalData_link_components AND @UD_WITH_ARROW_FILES@)
  enable_language(CXX)
  find_dependency(UDArrow 23)
endif()
if(@UD_WITH_POSTGRESQL@)
  find_dependency(PostgreSQL 17)
endif()
include("${CMAKE_CURRENT_LIST_DIR}/UniversalDataTargets.cmake")
foreach(component Foundation Columnar Expression Compute Runtime Contracts Plugins Package Data)
  if(TARGET UniversalData::${component})
    set(UniversalData_${component}_FOUND TRUE)
  endif()
endforeach()
check_required_components(UniversalData)
