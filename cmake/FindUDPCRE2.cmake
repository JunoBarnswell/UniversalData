find_path(UDPCRE2_INCLUDE_DIR pcre2.h)
find_library(UDPCRE2_LIBRARY NAMES pcre2-8)
if(UDPCRE2_INCLUDE_DIR)
  file(STRINGS "${UDPCRE2_INCLUDE_DIR}/pcre2.h" UDPCRE2_MAJOR_LINE REGEX "^#define PCRE2_MAJOR[ ]+[0-9]+")
  file(STRINGS "${UDPCRE2_INCLUDE_DIR}/pcre2.h" UDPCRE2_MINOR_LINE REGEX "^#define PCRE2_MINOR[ ]+[0-9]+")
  string(REGEX REPLACE ".*PCRE2_MAJOR[ ]+([0-9]+).*" "\\1" UDPCRE2_MAJOR "${UDPCRE2_MAJOR_LINE}")
  string(REGEX REPLACE ".*PCRE2_MINOR[ ]+([0-9]+).*" "\\1" UDPCRE2_MINOR "${UDPCRE2_MINOR_LINE}")
  set(UDPCRE2_VERSION "${UDPCRE2_MAJOR}.${UDPCRE2_MINOR}")
endif()
include(FindPackageHandleStandardArgs)
find_package_handle_standard_args(UDPCRE2 REQUIRED_VARS UDPCRE2_INCLUDE_DIR UDPCRE2_LIBRARY VERSION_VAR UDPCRE2_VERSION)
if(UDPCRE2_FOUND AND NOT TARGET UDPCRE2::PCRE2)
  add_library(UDPCRE2::PCRE2 UNKNOWN IMPORTED)
  set_target_properties(UDPCRE2::PCRE2 PROPERTIES IMPORTED_LOCATION "${UDPCRE2_LIBRARY}" INTERFACE_INCLUDE_DIRECTORIES "${UDPCRE2_INCLUDE_DIR}")
endif()
