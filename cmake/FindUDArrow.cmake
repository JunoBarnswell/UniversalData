find_path(UDArrow_INCLUDE_DIR arrow/api.h PATH_SUFFIXES include)
find_library(UDArrow_LIBRARY NAMES arrow libarrow.so.2300)
find_library(UDArrow_PARQUET_LIBRARY NAMES parquet libparquet.so.2300)
set(UDArrow_VERSION 23)
include(FindPackageHandleStandardArgs)
find_package_handle_standard_args(UDArrow REQUIRED_VARS UDArrow_INCLUDE_DIR UDArrow_LIBRARY UDArrow_PARQUET_LIBRARY VERSION_VAR UDArrow_VERSION)
if(UDArrow_FOUND AND NOT TARGET UDArrow::Arrow)
  add_library(UDArrow::Arrow SHARED IMPORTED)
  set_target_properties(UDArrow::Arrow PROPERTIES IMPORTED_LOCATION "${UDArrow_LIBRARY}" INTERFACE_INCLUDE_DIRECTORIES "${UDArrow_INCLUDE_DIR}")
  add_library(UDArrow::Parquet SHARED IMPORTED)
  set_target_properties(UDArrow::Parquet PROPERTIES IMPORTED_LOCATION "${UDArrow_PARQUET_LIBRARY}" INTERFACE_INCLUDE_DIRECTORIES "${UDArrow_INCLUDE_DIR}" INTERFACE_LINK_LIBRARIES UDArrow::Arrow)
endif()
