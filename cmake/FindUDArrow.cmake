find_path(UDArrow_INCLUDE_DIR arrow/api.h PATH_SUFFIXES include)
if(UDArrow_INCLUDE_DIR)
  file(STRINGS "${UDArrow_INCLUDE_DIR}/arrow/util/config.h" UDArrow_MAJOR_LINE REGEX "^#define ARROW_VERSION_MAJOR[ ]+[0-9]+")
  file(STRINGS "${UDArrow_INCLUDE_DIR}/arrow/util/config.h" UDArrow_MINOR_LINE REGEX "^#define ARROW_VERSION_MINOR[ ]+[0-9]+")
  file(STRINGS "${UDArrow_INCLUDE_DIR}/arrow/util/config.h" UDArrow_PATCH_LINE REGEX "^#define ARROW_VERSION_PATCH[ ]+[0-9]+")
  foreach(part MAJOR MINOR PATCH)
    string(REGEX REPLACE ".*ARROW_VERSION_${part}[ ]+([0-9]+).*" "\\1" UDArrow_${part} "${UDArrow_${part}_LINE}")
  endforeach()
  set(UDArrow_VERSION "${UDArrow_MAJOR}.${UDArrow_MINOR}.${UDArrow_PATCH}")
endif()
find_library(UDArrow_LIBRARY NAMES arrow libarrow.so.${UDArrow_MAJOR}00)
find_library(UDArrow_PARQUET_LIBRARY NAMES parquet libparquet.so.${UDArrow_MAJOR}00)
include(FindPackageHandleStandardArgs)
find_package_handle_standard_args(UDArrow REQUIRED_VARS UDArrow_INCLUDE_DIR UDArrow_LIBRARY UDArrow_PARQUET_LIBRARY VERSION_VAR UDArrow_VERSION)
if(UDArrow_FOUND AND NOT TARGET UDArrow::Arrow)
  if(WIN32)
    # Windows PyArrow wheels ship private, hash-named DLLs beside the package.
    get_filename_component(arrow_library_directory "${UDArrow_LIBRARY}" DIRECTORY)
    if(IS_DIRECTORY "${arrow_library_directory}.libs")
      set(UDArrow_RUNTIME_DIRECTORY "${arrow_library_directory}.libs")
    endif()
  endif()
  # find_library locates the link input, which may be a Windows import library.
  add_library(UDArrow::Arrow UNKNOWN IMPORTED)
  set_target_properties(UDArrow::Arrow PROPERTIES IMPORTED_LOCATION "${UDArrow_LIBRARY}" INTERFACE_INCLUDE_DIRECTORIES "${UDArrow_INCLUDE_DIR}")
  add_library(UDArrow::Parquet UNKNOWN IMPORTED)
  set_target_properties(UDArrow::Parquet PROPERTIES IMPORTED_LOCATION "${UDArrow_PARQUET_LIBRARY}" INTERFACE_INCLUDE_DIRECTORIES "${UDArrow_INCLUDE_DIR}" INTERFACE_LINK_LIBRARIES UDArrow::Arrow)
endif()
